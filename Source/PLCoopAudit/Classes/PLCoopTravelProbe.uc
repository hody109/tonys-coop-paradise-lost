class PLCoopTravelProbe extends CoopPLGameInfo;
var int Phase;
var float NextProbe;
var CoopPLPlayerClient A,B;
var CoopPLTelepadBlocker Gate;
var Telepad Pad;
var vector StartA,StartB;
function Check(bool OK,string Message)
{
 if(OK) Log("PLTRANS|PASS|"$Message); else Log("PLTRANS|FAIL|"$Message);
}
event Tick(float D)
{
 local CoopPLPlayerClient P;
 local CoopPLTelepadBlocker G;
 local vector V;
 Super.Tick(D);
 if(Level.TimeSeconds<NextProbe || Phase>3) return;
 NextProbe=Level.TimeSeconds+3;
 A=None; B=None;
 foreach DynamicActors(class'CoopPLPlayerClient',P)
  if(P.Player!=None && P.Pawn!=None) {if(A==None) A=P;else B=P;}
 if(A==None || B==None || Level.TimeSeconds<40) return;
 if(InStr(Caps(string(Level)),"PL-COMPOUND")>=0) return;
 if(Phase==0)
 {
  StopSceneManagers();
  foreach DynamicActors(class'CoopPLTelepadBlocker',G)
   if(G.Sentinel!=None && Telepad(G.Owner)!=None && Telepad(G.Owner).bEnabled)
   { Gate=G;break; }
  if(Gate==None) {Log("PLTRANS|WAIT|no enabled pad");return;}
  Pad=Telepad(Gate.Owner);
  Log("PLTRANS|pad="$Pad$"|url="$Pad.URL$"|loc="$Pad.Location$"|radius="$Pad.CollisionRadius);
  StartA=A.Pawn.Location;StartB=B.Pawn.Location;
  // At the gathering ring, outside the physical blocker.
  V=Pad.Location;V.X+=Pad.CollisionRadius+A.Pawn.CollisionRadius+5;
  A.Pawn.bCollideWorld=false;
  Check(A.Pawn.SetLocation(V),"first player placed at real exit");
  A.Pawn.SetPhysics(PHYS_None);
  Check(!Gate.Sentinel.GetFinalAccess(),"first player waits for teammate");
 }
 else if(Phase==1)
 {
  V=Pad.Location;V.X-=Pad.CollisionRadius+B.Pawn.CollisionRadius+5;
  B.Pawn.bCollideWorld=false;
  Check(B.Pawn.SetLocation(V),"second player placed at real exit");
  B.Pawn.SetPhysics(PHYS_None);
 }
 else if(Phase==2)
 {
  Check(Gate.bPLOpen && !Gate.bCollideActors && !Gate.bBlockPlayers,"real wall removed with whole team present");
  Check(Gate.Sentinel.GetFinalAccess(),"both players counted at real exit");
  // Actual Touch generated by moving into the map's real telepad.
  V=Pad.Location;
  Log("PLTRANS|ENTER|"$Pad.URL);
  A.Pawn.SetLocation(V);
 }
 else
 {
  Log("PLTRANS|FAIL|map did not travel after real telepad entry");
 }
 Phase++;
}

defaultproperties
{
 PlayerControllerClassName="PLCoopAudit.PLCoopTravelClient"
}
