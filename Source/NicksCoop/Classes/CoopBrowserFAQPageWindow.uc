class CoopBrowserFAQPageWindow extends CoopBrowserPageWindow;

defaultproperties
{
	HTMLHeaders(0)="Home page"
	HTMLPages(0)="<ue><center><br><a href=ubl.1>Hot keys</a><br>Scoreboard, chat, taunts, cheats<br>Show Players, Coop Teleport<br><br><a href=ubl.2>How to start game</a><br>Join game and Host game<br><br><a href=ubl.3>Player settings</a><br>Player name, skin type, etc<br><br><a href=ubl.5>Changelog</a><br>Actual fixes<br><br><a href=ubl.6>About mod</a><br>Info about the mod, supporting project<br><br><a href=ubl.9>Tech support</a><br>Errors, unusual problems, links<br>looking for co-op partner</center></ue>"

	HTMLHeaders(1)="Hot keys"
	HTMLPages(1)="<ue><center><a href=ubl.13>Taunts</a><br>Player dancing, etc.<br><br><a href=ubl.14>Cheats</a><br>Grant items, spawn characters, etc.<br><br><a href=ubl.15>Admin commands</a><br>Ban and kick players, etc.<br><br><u>Common hot keys</u><br>F1 - scoreboard<br>F5 - quick save<br>B - chat message<br>[~] - chat and game console<br>Pause | Break - pause game (admins only)<br><br><u>Menu keys</u><br>Show Players - realtime player position indicator.<br><u>NOTE:</u> To deactivate press (Show Players) one more time.<br>Coop Teleport - teleport to certain player.<br><u>NOTE:</u> To choose teleport position - activate (Show Players) first.<br><u>NOTE:</u> Press right mouse button over the menu to Disable/Enable others teleport to your position<br><br><u>Control animals spectate</u><br>You can control dogs and cats only.<br>Left mouse - switching between pawns.<br>Right mouse - attack mode order.<br>1,2,3,4,5,6,7,8,9 buttons - special orders</center></ue>"

	HTMLHeaders(2)="How to start game"
	HTMLPages(2)="<ue><br><b>Host server game</b><br><br>Open: ... [Co-Op Game] ... [Host Game]<br>On appeared window you can change various settings of your server: <a href=ubl.7> more info </a><br>Press [Continue] to continue the previous saved game, otherwise [New Game] will start new game and erase any game progress <br><br><b>Join existing game</b><br><br>Open: ... [Co-Op Game] ... [Join Game]<br>You can choose server from 'NicksCoop'/'LAN'/'All' tabs<br>Or you can join server directly, if you know it's IP - 'Direct' tab<br>To test server connection press Info button<br>Public servers are available to check on master server page: <a href=http://master.333networks.com/s/postal2> more info </a><br><br><b>Troubleshooting</b><br><br>If you or your friends can't join the game: <a href=https://steamcommunity.com/workshop/filedetails/discussion/737631813/154644045364473781/> more info </a><br>Full guide how to host your server: <a href=https://steamcommunity.com/workshop/filedetails/discussion/737631813/1696045708655297815/> more info </a><br></ue>"

	HTMLHeaders(3)="Player settings"
	HTMLPages(3)="<ue><center><br><u>Ping optimization</u> - makes smoother gameplay with high ping<br>No matter if you have a low ping, this option will not do any harm<br><br><u>Player name</u> - your name in game<br><br><u>Skin setup</u> - the appearance of your avatar in game<br></center></ue>"

	HTMLHeaders(4)="EMPTY"
	HTMLPages(4)="EMPTY"

	HTMLHeaders(5)="Changelog"
	HTMLPages(5)="<ue><center><br><u>2015 - beta</u><br>-uses 1407 postal 2 build<br><br><u>25.08.2015 - beta</u><br>-ported to steam build<br><br><u>05.08.2016 - v 1.0.0</u><br>-released<br><br><u>02.07.2017 - v 1.1.0</u><br>-update, <a href=ubl.8> change log </a><br><br><u>20.08.2017 - v 1.2.0</u><br>-update, <a href=ubl.10> change log </a><br><br><u>16.12.2018 - v 1.3.0</u><br>-update, <a href=ubl.11> change log </a><br><br><u>28.06.2020 - v 1.4.0</u><br>-update, <a href=ubl.12> change log </a></center></ue>"

	HTMLHeaders(6)="About mod"
	HTMLPages(6)="<ue><center><br>Nick's Coop<br>Version: 1.4.3<br><br><u>Author:</u> Nick Pilshikov a.k.a Evil<br><a href=https://discord.gg/P7jZEUu3vP> - Discord server - </a><br><br><u>Beta testing:</u> Anton Voroncov a.k.a A-Mod, <br>Djamil Guseynov a.k.a Mormon, Erik Rossik a.k.a ErikFOV, <br>Maxim Popov a.k.a FlaFsteR<br><br><u>Special thanks:</u> <br>Donated: Miles Thatch<br>Other: Zyphinx (recoil damping help), Regulator <br>(UDP server list), JustDoIt (SecureValidate fix code)<br><br><a href=http://www.paypal.me/nickpilshikov> - Support project - </a><br><br><br></center></ue>"

	HTMLHeaders(7)="Server parameters"
	HTMLPages(7)="<ue><center><br><u>Dedicated server</u> - fully autonomous server<br>If checked, server will be launched as separate application<br><br><u>Story mode</u> - select game type story mode <br>(POSTAL 2 - 5 days, Apocalypse Weekend - 2 days weekend, A Week In Paradise - 7 days week)<br><br><u>Load intro</u> - if checked, game starts with intro<br><br><u>Difficulty</u> - game difficulty<br><br><u>Public listing</u> - if checked, your server's IP will be uploaded to <a href=http://master.333networks.com/g/postal2>MasterServer page</a><br><br><u>Server Name</u> - displaying server name<br><br><u>Game Password</u> - server enter password<br><br><u>Admin Password</u> - password to access admin menu (save/load/restart game)<br><br><u>Friendly Fire</u> - Sets how much damage other players will take from friendly fire (0-100%)<br><br><u>Players num limit</u> - How many players can join your server, including you (2-16)<br><br><u>Spectators num limit</u> - How many spectators can join your server (0-16)<br><br><u>Travel access limit</u> - How many players need to travel between levels (0-100%)<br>For example if 50% -> you need more than 50% players to pass the next level area<br><br><u>No holiday events</u> - if checked, holiday events will be disabled<br><br><u>Ragdoll synchronization</u> - sync for dead bodies<br>If checked, dead bodies ragdolls will be synced with their server positions.<br>This setting (checked) extremely usefull for Apocalypse Weekend, where <br>you can ressurect dead zombies (only on non-dedicated server)<br><br><br><br><br><br><u>Report LOG (config) TRUE/FALSE</u> - if TRUE, game will write information about players connections to ReportLog_Date.log<br>To setup this option open Postal2CoOp.ini<br><br>[NicksCoop.CoopGameInfo]<br>bReportLogEnabled=TRUE</center></ue>"

	HTMLHeaders(8)="v1.1.0 changelog"
	HTMLPages(8)="<ue><br><b>v 1.1.0 changelog</b><br><br>- NPC's empty BaseEquipment array fixed <br>- Animations synchronization fixed <br>- GasCan 0 ammo fixed <br>- Ragdolls synchronization added <br>- Variants of Ragdolls synchronization (synch/no synch) added <br>- Friendly Fire added <br>- Skin Setup added <br>- ControllerClass/WeaponClass replace in PawnSpawner and ACTION_* fixed <br>- Disabling holiday events option added <br>- Zombie client effects fixed <br>- Tick() limitations added <br>- Typing status icon added <br>- Hide pawns while travel fixed <br>- Hide dead effects while travel fixed <br>- Show Players player searching method fixed <br>- Players limit option added <br>- NPC's alert function limitation added <br>- Client bullet splats fixed <br>- Game exiting/closing fixed <br>- Kicking heads fixed <br>- Client GameEnd stats added <br>- Client zombies AI fixed <br>- Game closing after stats fixed <br>- Client cow's head dummy synch fixed <br>- Ability to shoot while dead fixed <br>- Heads LODBias fixed <br>- comGoto cheat added <br>- custom mods/maps menu added <br>- Clothes changing system fixed <br>- Linux and Mac compatibility alert window added <br>- New join window with Direct and LAN <br>- Client version of Weapon selector added <br>- Backspace 'closing' bug fixed <br>- Client boltons added <br>- Admin commands added <br>- FakePlayer bug protection added <br>- SecureValidate by JustDoIt added <br>- UDP ServerList by Regulator added <br></ue>"

	HTMLHeaders(9)="Tech support"
	HTMLPages(9)="<ue><center><br><a href=http://steamcommunity.com/sharedfiles/filedetails/?id=737631813> - Steam workshop NicksCoop page - </a><br>Official steam workshop page<br><br><a href=http://steamcommunity.com/sharedfiles/filedetails/discussions/737631813> - Steam workshop discussions for NicksCoop - </a><br>A lot of useful threads, please check it, probably your problem described there<br><br><a href=http://master.333networks.com/s/postal2> - Official POSTAL2 Masterserver page - </a><br>All the public servers are displayed here. There are a lot of not compatible POSTAL2 STP servers too.<br><br><a href=https://discord.gg/zVd63G65PM> - POSTAL community Discord (RWS official) - </a><br>You can find there people to play NicksCoop together, just ask for it in text-channels<br><br><a href=http://steamcommunity.com/workshop/filedetails/discussion/737631813/154645214960065468/> - Steam workshop troubleshooting thread for NicksCoop - </a><br>You can describe your problem there, for unusual problems only<br><br><a href=http://steamcommunity.com/workshop/filedetails/discussion/737631813/1471967615883976603/> - Click here to report a bug you have found - </a><br>You can report about bugs you have found</center></ue>"

	HTMLHeaders(10)="v1.2.0 changelog"
	HTMLPages(10)="<ue><br><b>v 1.2.0 changelog</b><br><br>-Dedicated server<br>-New level travel blocking system<br>-New Lut save system (v1.0.0-v1.1.0 saves may not work)<br>-Player arrest notify message<br>-New spectating system<br>-Spectating animals control<br>-Player idling detection<br>-5022 subtitle system implemented<br>-Client map widescreen fix<br>-rare client ragdoll glitches fixed<br>-favorites join section added<br>-Host player cutscene teleport fixed<br>-All players day-based inventory<br>-dead players NPC notify fixed<br>-cats, dogs slow run-walk anims fixed<br>-cats, dogs glitchy urine fixed<br>-client newspaper fixed<br>-report log added<br>-coop teleport restrictions added<br><br><b>v 1.2.1 HOT-FIX (21.08.2017)</b><br><br>-Player save issue fixed<br>-Special spectate animal double control fixed<br>-Dedicated start from workshop fixed<br>-Travel access bug fixed<br>-New player skins added<br><br><b>v 1.2.2 HOT-FIX (25.08.2017)</b><br><br>-Travel-portal fix for any game-ports<br>-SaveSycle functionality changed, now used to remove 1-visit saves<br>-LowerParadise3 1000000 iterations crash fix<br>-Flamethrower(Stynx) invisible emitter fix<br>-Interactions issues/crashes fix<br>-Unavailable client map screen fix<br>-Smaller travel blocker sentinel collision fix<br>-Stucking player start fix<br>-Detached head blood feeder fix<br>-Urine emitter types fix<br>-Brewery's glitchy mover removed<br>-Unwanted cut-scene's pawn fix<br>-OGG music start/stop (ACTION_PlayMusic) fix<br>-3rd invisible guns fix<br><br><b>v 1.2.3 HOT-FIX (01.09.2017)</b><br><br>-wanted icon for wide-screen fixed<br>-predefined NicksCoopSave data fixed<br>-manual save restrictions added<br>-level restart travel-portal fixed<br>-level switch added to report log<br><br><b>v 1.2.4 HOT-FIX (02.09.2017)</b><br><br>-after arrest cop chasing bug fixed<br>-travel blocker collision bug fixed<br>-coop add-on's additional skins swaping fixed<br>-ROM save now contain health, last gun, current clothes<br>-dead bodies collision bug fixed<br>-client-side admin mod/map-load menus added<br>-admin cheats added<br><br><b>v 1.2.5 HOT-FIX (22.10.2017)</b><br><br>-spawning glitch guns during apocalypse fixed<br>-client chompy bug fixed<br>-Hospital and GayFish2 crashes fixed<br>-Hospital elevator bug fixed<br>-Dog kills stat fixed<br>-new cheats added: SkeletonWar, SkeletonJihad, RiotMode, RocketGuys, GimmeGuysGuns<br><br><b>v 1.2.6 HOT-FIX (05.11.2017)</b><br><br>-weapon replace list char register fix<br>-new taunts added: comLaugh, comAngry, comApplause, comShock, comScream, comThumbup, comFleas, comKiss, comThatsMe<br>-matinee camera interpolation speed fix<br>-enhanced urethra fix for client<br>-hospital elevator fix #2<br>-client catnip glitch fix<br>-kevlar now saves<br>-enhanced gary head weapon fix<br>-wmd effects fix<br>-limbs on dedicated server now removes by time<br>-enhanced M79 projectile fix<br>-enhanced sledge projectile fix<br>-player now saves automatically while exiting<br>-bystanders now respawns BystanderRefill system v1.0 (bUseBystandersRefill=true in main config)<br>-militarybase3 elevator fix<br>-Pitchfork weapon fix<br>-new cheat Nudes<br>-enhanced dusters slow down the time fix<br>-config for extra start items CustomCoopInvStarting, in NicksCoopInvReplace.ini<br>-new weapon Broom, you can fly on it (like enhanced shovel) CoopExtra_WitchBroomWeapon<br>-non-dedicated server saves bug fix<br><br><b>v 1.2.7 HOT-FIX (19.11.2017)</b><br><br>-new cheats added: IWant, Summon, CustomBystanders<br>-new admin commands added: comEndGame, comNextDay<br>-new client commands: TCam, BCam - 3rd view<br>-new taunts added: comObscene<br>-addon MapScreen swap bug fixed<br>-Connection type menu removed<br>-Custom and hard difficulties fixed<br>-Permanent clothes from mods<br>-Petition now removes in other days<br>-Broom firing speed increased<br>-Dynamite bot firing fixed<br>-Weapon selector starting fixed<br>-Scene teleport fixed<br><br><b>v 1.2.8 HOT-FIX (18.12.2017)</b><br><br>-Ping optimization added<br>-Old saves load fixed<br></ue>"

	HTMLHeaders(11)="v1.3.0 changelog"
	HTMLPages(11)="<ue><br><b>v 1.3.0 changelog</b><br><br>-auto saving/loading on non-dedicated<br>-Spectator ping opimization fix<br>-Weapon list load fix<br>-Dead players spectating<br>-Separated wanted status for each player<br>-Travel portal bug fixed<br>-Culldistance issues fix<br>-F1 while cinematic available<br>-Subtitles on client map now shows up<br>-Errand save issues fixed<br>-Vote menu for progress reset added<br>-iwant cheat fixed<br>-New players indicator icon<br>-Players indicator traces removed<br>-Security/admin system updated<br>-Items consfiscation added to client<br>-FOV issues fixed<br>-New arrest system<br>-Player stats storage time increased<br>-Restart level option moved to admin menu<br>-Weapon selector client fixes<br>-Minor net code optimizations<br>-Weapon selection sound fixed<br><br><b>v 1.3.1 HOT-FIX (19.12.2018)</b><br><br>-Crushed death teleport implemented<br>-Revive cheat added<br>-GimmeNuke cheat added<br>-GimmeBroom cheat added<br>-Replication system (NETChameleon) rework<br>-Ragdoll initialization fix<br>-Ragdoll sync removed due to perfomance issues<br></ue>"

	HTMLHeaders(12)="v1.4.0 changelog"
	HTMLPages(12)="<ue><br><b>v 1.4.0 changelog</b><br><br>Some of the major changes were done in the native code of the Postal 2<br>Complete build 5024, this will improve the game and network perfomance.<br><br>-skin replication moved to the 5024 (native)<br>-basic animations replication moved to the 5024 (native)<br>-locomotion animation replication moved to the 5024 (native)<br>-most of weapon client fixes moved to the 5024<br>-weapon selector client fixes moved to the 5024<br>-HUD fixes moved to the 5024<br>-FireDetail and SmokeDetail sliders now work client-side (5024)<br>-subtitles client initialization moved to the 5024<br>-animations initialization moved to the 5024<br>-most of emitter fixes moved to the 5024<br>-menu elements fixes (sliders) moved to the 5024<br>-TCP based server browser implemented (fixed on 5024)<br>-menu dialogs text fixes moved to the 5024<br>-new limbs and stumps client system (5024)<br>-head class fixes moved to the 5024<br>-bottom body part now explodes on the client (5024)<br>-FOV change fixes moved to the 5024<br>-weapon 3rd models disapper fix moved to the 5024<br>-emitters spamming issue fix (5024)<br>-characters aggression improved (5024)<br>-bullet holes removed from client (5024)<br>-SecureValidate fixes moved to the 5024<br>-new stream (e.g. urine, etc) replication (5024)<br>-added news tab to the menu<br>-inventory selector added to the clients<br>-machinegun, pistol and shotgun recoil damping removed<br>-catnip now have a cap when being used by a cat<br>-dismemberment disabled for EP_Dead characters<br>-max ammo amount fixed client-side for various weapons<br><br><b>v 1.4.1 HOT-FIX (31.01.2021)</b><br><br>-Greenbelt crash fixed<br>-NicksCoop tab not showing servers fixed<br>-FOV reset fixed<br>-Bystanders population limitations removed<br>-New cheats added: GimmeCrack, SummonBystanders, SummonGaryGhost, SummonGaryCowheadRun, GaryCowheadRunTown<br>-New ragdoll synchronization system added<br>-Recoil damping completely removed<br>-Added confirmation boxes when Continue and New Game is pressed<br>-Disappearing heads on corpses fixed<br>-Cheats and commands auto-typing implemented<br>-Bystanders limit option added<br><br><b>v 1.4.2 HOT-FIX (02.05.2021)</b><br><br>-incorrect cutscenes teleport fix<br>-cutscenes crash fix<br>-EastMall STEME cutscene activation once<br>-enabled ragdoll sync log spam fix<br>-gamepad control in the game menu fixed<br>-potential fix for news-browser crash<br>-TrainingCamp2 password glitched menu fixed<br><br><b>v 1.4.3 HOT-FIX (15.10.2022)</b><br><br>-loading screen background added back<br>-inventory menu disabled<br>-names glitch after level transitions fixed<br>-inventory backpack changed to rotating chest<br>-fluid surfaces fixed on clients<br>-lowered default save limits<br>-ED_Dead pawns respawn fixed<br>-animal control animations fixed<br>-animal control removed fear from shots<br>-animal control added jump action<br>-commiddlefinger taunt changed dialog<br>-all taunts wont trigger NPC, except commiddlefinger<br></ue>"

	HTMLHeaders(13)="Taunts"
	HTMLPages(13)="<ue><center><a href=concom>comDance</a><br><br><a href=concom>comDoSpecial</a><br><br><a href=concom>comMiddleFinger</a><br><br><a href=concom>comLaugh</a><br><br><a href=concom>comAngry</a><br><br><a href=concom>comApplause</a><br><br><a href=concom>comShock</a><br><br><a href=concom>comScream</a><br><br><a href=concom>comThumbup</a><br><br><a href=concom>comFleas</a><br><br><a href=concom>comKiss</a><br><br><a href=concom>comThatsMe</a><br><br><a href=concom>comObscene</a></center></ue>"

	HTMLHeaders(14)="Cheats"
	HTMLPages(14)="<ue><center><br><u>WARNING:</u> Cheats disables achievements, marks game as cheating.<br><br><a href=concom>admin comEnhanced</a> BOOL<br>-turns on/off enhanced mode (admin comEnhanced TRUE - on, admin comEnhanced FALSE - off)<br><br><a href=concom>admin ConCom</a> COMMAND<br>-object manipulations, example: admin ConCom set Head DrawScale 2<br><br><a href=concom>admin PackNHeat</a> PlayerName<br>-give a lot of guns to player, if no player specified, gives to all the player on the level<br><br><a href=concom>admin PayLoad</a> PlayerName<br>-give a lot of ammo to player, if no player specified, gives to all the player on the level<br><br><a href=concom>admin GimmeNuke</a> PlayerName<br>-gives nuke launcher to the player<br><br><a href=concom>admin GimmeBroom</a> PlayerName<br>-gives broom to the player<br><br><a href=concom>admin Osama</a><br>-turns all the bystanders into talibans<br><br><a href=concom>admin KrotchatizeMe</a><br>-turns all the bystanders into krotchys<br><br><a href=concom>admin JewTown</a><br>-turns all the bystanders into mike-jews<br><br><a href=concom>admin Zombification</a><br>-turns all the bystanders into zombies<br><br><a href=concom>admin SkeletonWar</a><br>-turns all the bystanders into skeletons<br><br><a href=concom>admin SkeletonJihad</a><br>-turns all the bystanders into explodable skeletons<br><br><a href=concom>admin RiotMode</a><br>-gives all the bystanders random guns<br><br><a href=concom>admin RocketGuys</a><br>-gives all the bystanders rocket launchers<br><br><a href=concom>admin GimmeGuysGuns</a> PACKAGE.CLASS<br>-gives all the bystanders certain gun, example: AWPStuff.ChainsawWeapon<br><br><a href=concom>admin Nudes</a><br>-makes all girls nude<br><br><a href=concom>admin IWant</a> PlayerName_+_PACKAGE.CLASS<br>-gives player a certain gun, example: IWant Nick_+_AWPStuff.ChainsawWeapon<br><br><a href=concom>admin Summon</a> PACKAGE.CLASS<br>-spawns certain object class, example: Summon Postal2Holidays.GaryGhost<br><br><a href=concom>admin CustomBystanders</a> PACKAGE.CLASS<br>-turns all the bystanders into certain pawn class, example: CustomBystanders Postal2Holidays.GaryGhost<br><br><a href=concom>admin GimmeCrack</a> PlayerName<br>-gives a crack pipe to the PlayerName, if not specified, to all players<br><br><a href=concom>admin SummonBystanders</a><br>-spawns an regular bystander character<br><br><a href=concom>admin SummonGaryGhost</a><br>-spawns a Gary ghost character<br><br><a href=concom>admin SummonGaryCowheadRun</a><br>-spawns a Gary cowhead running character (enemy from Apocalypse Weekend)<br><br><a href=concom>admin GaryCowheadRunTown</a><br>-replaces all the bystanders with Gary cowhead running characters (enemy from Apocalypse Weekend)<br><br><u>WARNING:</u> Do not use cheats below while cinematic scenes and levels loading, can cause bugs and crashes!<br><br><a href=concom>admin comGoto</a> LEVEL_NAME<br>- cheat to change level<br><br><a href=concom>admin comEndGame</a><br>- cheat to finish game (blank game for dedicated server)<br><br><a href=concom>admin comNextDay</a><br>- cheat to warp to the next day<br><br></center></ue>"

	HTMLHeaders(15)="Admin commands"
	HTMLPages(15)="<ue><center><a href=concom>admin MuteForever</a> PlayerName<br>-mute for player for one level<br><br><a href=concom>admin MuteFor</a> PlayerName_+_30<br>-specified (sec) mute for player for one level<br><br><a href=concom>admin MuteMin</a> PlayerName<br>-60sec mute for player for one level<br><br><a href=concom>admin Zero</a> PlayerName<br>-resets player's score<br><br><a href=concom>admin Ban2</a> PlayerName<br>-ban player by name<br><br><a href=concom>admin Kick2</a> PlayerName<br>-kick player by name<br><br><a href=concom>admin Kill</a> PlayerName<br>-kill specified player<br><br><a href=concom>admin Revive</a> PlayerName<br>-revive specified player<br><br><u>NOTE:</u> If you needs to unban player, you need to open Postal2CoOp.ini,<br>which is located ...POSTAL2Complete/WorkshopContent/737631813, or<br>...POSTAL2Complete/System if you're playing on manually installed mod.<br>Find player's IP and wipe certain entry, or wipe all IPPolicies entries from<br>[Engine.AccessControl] and IPPoliciesExtend entries from [NicksCoop.CoopAccessControl]</center></ue>"

	HTMLHeaders(16)="EMPTY"
	HTMLPages(16)="EMPTY"
}